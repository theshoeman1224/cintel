ifeq ($(CONFIG),linux)
FEATURE_TELEMETRY := 1
USE_FAST_FILTER := 1
CHECKSUM_WIDTH := 32
OPTIMIZATION := -O2
CONFIG_DEFINES := -DPLATFORM_LINUX -DFEATURE_TELEMETRY=1 -DUSE_FAST_FILTER=1 -DCHECKSUM_WIDTH=32
else ifeq ($(CONFIG),embedded)
FEATURE_TELEMETRY := 0
USE_FAST_FILTER := 0
CHECKSUM_WIDTH := 16
OPTIMIZATION := -O0
CONFIG_DEFINES := -DPLATFORM_EMBEDDED -DFEATURE_TELEMETRY=0 -DUSE_FAST_FILTER=0 -DCHECKSUM_WIDTH=16
else ifeq ($(CONFIG),tests)
FEATURE_TELEMETRY := 0
USE_FAST_FILTER := 1
CHECKSUM_WIDTH := 32
OPTIMIZATION := -O1
CONFIG_DEFINES := -DPLATFORM_LINUX -DUNIT_TEST -DFEATURE_TELEMETRY=0 -DUSE_FAST_FILTER=1 -DCHECKSUM_WIDTH=32
else
$(error Unknown CONFIG '$(CONFIG)')
endif

CPPFLAGS += $(CONFIG_DEFINES)
CFLAGS += $(OPTIMIZATION)
